# Unreal build artifacts -- 2.8 GB, all regenerable from Source/ + .uproject
VRgridViewer/Binaries/
VRgridViewer/Intermediate/
VRgridViewer/Saved/
VRgridViewer/DerivedDataCache/
VRgridViewer/.vs/
*.sln

# Generated by Content/Python/setup_assets.py -- run `demo.ps1 materials`
# rather than committing a binary .uasset nobody can review in a diff.
VRgridViewer/Content/VRgrid/

# Baked exports. Hundreds of MB per scene; re-bake with `demo.ps1 bake`.
scenes/

__pycache__/
*.pyc

# Epic's mannequin/vehicle content, pulled in from the engine plugins. 126 MB
# of third-party .uasset that is not ours to redistribute and that the plugin
# supplies anyway.
VRgridViewer/Content/Characters/

.pytest_cache/
